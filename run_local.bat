@echo off
chcp 65001 >nul
title تشغيل بوت تليجرام محلياً للتجربة

echo ===================================================
echo  تشغيل بوت تليجرام للتجربة على جهازك
echo ===================================================

if not exist ".env" (
    echo [!] ملف .env غير موجود. سيتم إنشاؤه الآن.
    set /p token="يرجى إدخال توكن البوت الخاص بك من BotFather: "
    echo BOT_TOKEN=%token% > .env
    echo [+] تم حفظ التوكن في ملف .env
)

echo [*] جاري تشغيل البوت...
python bot.py
pause
